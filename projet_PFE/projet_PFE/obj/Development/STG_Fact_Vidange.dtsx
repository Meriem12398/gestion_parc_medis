-- Identifiants
d.idvidange
,d.vehicule_id

-- Les dates
,d.date_vidange 
,d.prochaine_date as prochaine_date_vidange

-- Les autres axes d'analyse 
,d.statut
,d.remarque
,d.type_huile

-- Les indicateurs (KPI) 
,d.cout as Cout_Vidange 
,d.kilometrage_vidange  -- à vérifier avec l'entreprise s'il y a un besoin de garder les colonnes kilometrage_vidange et
																-- prochain_kilometrage pour faire des analyses
,d.prochain_kilometrage



 from dbo.Vidange d   -- fact table</property>
