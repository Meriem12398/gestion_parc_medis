            <component
              refId="Package\Tâche de flux de données\Source OLE DB"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="Source OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;7"
              description="Source OLE DB"
              name="Source OLE DB"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="Nombre de secondes avant l'expiration d'une commande.  Une valeur égale à 0 indique un délai d'expiration infini."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                  name="OpenRowset">[dbo].[Vehicule]</property>
                <property
                  dataType="System.String"
                  description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Commande SQL à exécuter."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select  
-- les Identifiants 
m.idmission 
,m.idvehicule
,m.iddemande
,m.chauffeur_matricule

-- les colonnes date
,m.date_debut as date_debut_mission 
,m.date_fin as date_fin_mission
,i.date_incident 
,inter.date_intervention 
,d.date_creation as date_de_demande
,d.date_souhaite as date_souhaitee_de_demande



-- Axe d'analyse localité 
,i.adresse as adresse_incident
,i.latitude
,i.longitude

-- les autres axes d'analyses 
,m.statut_mission 
,m.motif_annulation
,m.commentaire_chauffeur

,i.type_incident
,i.description	as description_incident

, inter.type_intervention
,inter.description	as Description_Intervention 

,d.description as Description_Demande
,d.priorite as  priorite_de_demande
,d.statut as Statut_de_Demande
,d.motif_refus as Motif_Refus_de_Demande
,d.type_demande


-- Les indicateurs (KPI) 
,inter.cout		as Cout_Intervention 


  FROM [dbo].[Mission] m 
  inner join [dbo].Incident i 
								on i.idmission = m.idmission
  inner join [dbo].Intervention inter 
								on inter.idincident = i.idincident 
  inner join [dbo].Demande d
								 on d.iddemande = m.iddemande</property>
                <property
                  dataType="System.String"
                  description="Variable contenant la commande SQL à exécuter."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Spécifie la page de codes de la colonne à utiliser lorsque les informations de page de codes ne sont pas disponibles à partir de la source de données."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Force l'utilisation de la valeur de propriété DefaultCodePage lors de la description des données caractères."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Spécifie le mode utilisé pour accéder à la base de données."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="Mappages entre les paramètres de la commande SQL et les variables."
                  name="ParameterMapping"></property>
              </properties>
